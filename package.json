{
  "name": "freshdrop-pos-v8",
  "version": "8.1.0",
  "description": "FreshDrop POS V8.1 desktop (Windows)",
  "main": "desktop/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "lk.freshdrop.pos",
    "productName": "FreshDrop POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "FreshDrop-POS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}